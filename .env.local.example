# Copy to .env.local and fill in. Never commit .env.local.
# Every value here must ALSO be added in Vercel → Settings → Environment Variables.

# ── OpenRouter ────────────────────────────────────────────────────────────
# Key from https://openrouter.ai/keys. Extraction and business-analysis
# synthesis both call the free `inclusionai/ling-3.0-flash-vl:free` model
# (see lib/openrouter.ts) — capped at 20 req/min and 50 req/day until you've
# bought $10 of credits at least once (then 1,000/day).
OPENROUTER_API_KEY=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────
# Meta dashboard → your app → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any random string you invent. Paste the SAME value into
# Meta → WhatsApp → Configuration → Webhook → Verify token.
WHATSAPP_VERIFY_TOKEN=

# Meta dashboard → App Settings → Basic → App Secret.
# Used to verify the X-Hub-Signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=

# Where qualified-lead alerts go. Full international format, digits only.
# Must be on the test number's allowlist (max ~5 recipients).
# e.g. 919876543210
SALES_ALERT_NUMBER=

# ── Google Sheets ─────────────────────────────────────────────────────────
# Google Cloud Console → IAM → Service Accounts → create → keys → JSON.
# Enable the Google Sheets API for the project.
# THEN share the Sheet with this email as Editor, or every write 403s.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The "private_key" field from that JSON, in quotes, newlines kept as \n.
# e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=

# From the Sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Tab name within the Sheet. Must match exactly, including case.
GOOGLE_SHEET_TAB=Leads

# Four more tabs in the same Sheet — create them by hand (Sheets API can't),
# then run `npm run sheet:init` to write their header rows.
GOOGLE_APPROVALS_TAB=Approvals
GOOGLE_RESEARCH_TAB=Research
GOOGLE_REJECTIONS_TAB=Rejections
GOOGLE_OUTCOMES_TAB=Outcomes

# ── Business research stage ───────────────────────────────────────────────
# Optional. A lead is still filed and alerted on without any of these — the
# research step just has less to work with.

# Google Cloud Console → APIs & Services → enable "Places API (New)" →
# Credentials → create an API key. Used for the Google-reviews signal.
GOOGLE_PLACES_API_KEY=

# Meta dashboard → your app → Instagram → API setup. Needs a connected
# Instagram Business/Creator account with Business Discovery access — same
# Meta app as the WhatsApp setup, but this is its own token/ID pair.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Your Calendly (or Cal.com) scheduling link — sent to the lead in the
# booking message. e.g. https://calendly.com/your-handle/15min
CALENDLY_LINK=
